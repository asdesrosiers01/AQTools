# Cached downloads and generated outputs from R/station_selection_audit.R.
# These are large, environment-specific, and fully reproducible from the
# script plus the source URLs recorded in data/processed/README.md, so
# they are not committed.
data/raw/*
data/processed/*
outputs/*

# Keep the directories themselves under version control.
!data/raw/.gitkeep
!data/processed/.gitkeep
!outputs/.gitkeep

# ...except the small synthetic test fixtures, which are source (checked
# in on purpose so the pipeline's logic can be sanity-checked before
# running against real data). See data/raw/test_fixtures/generate_fixtures.R.
!data/raw/test_fixtures/
!data/raw/test_fixtures/**

# R session artifacts
.Rhistory
.RData
.Rproj.user/
